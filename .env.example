# Docker environment variables
# Copy to .env and fill in your values

# GitHub Personal Access Token (required)
GITHUB_TOKEN=ghp_your_token_here

# Webhook secret for signature verification (required)
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Webhook server configuration (optional)
WEBHOOK_PORT=8080
WEBHOOK_HOST=0.0.0.0

# iFlow CLI npm package name (for Docker build)
# Change this if using a custom/enterprise iFlow package
IFLOW_NPM_PACKAGE=iflow
