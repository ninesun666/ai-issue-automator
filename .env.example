# ===========================================
# Issue Automator Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# ------------------
# GitHub Configuration
# ------------------
# GitHub Personal Access Token (required)
# Create at: https://github.com/settings/tokens
# Required scopes: repo, write:discussion
GITHUB_TOKEN=ghp_your_token_here

# Webhook secret for signature verification (required)
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# ------------------
# Server Configuration
# ------------------
# Webhook server port (default: 8080)
WEBHOOK_PORT=8080

# ------------------
# AI Configuration (iFlow CLI)
# ------------------
# API Key for AI model (required for automation)
# Supports: OpenAI, Azure, Anthropic, etc.
apiKey=your_api_key_here

# API Base URL (optional, use for custom endpoints)
# OpenAI: https://api.openai.com/v1
# Azure: https://your-resource.openai.azure.com/openai/deployments/your-deployment
# baseUrl=https://api.openai.com/v1

# Model name (optional)
# modelName=gpt-4

# ------------------
# Docker Build Configuration
# ------------------
# iFlow CLI npm package (use default unless custom)
IFLOW_NPM_PACKAGE=@iflow-ai/iflow-cli